	column 'Status Vigencia Plano de Acao' =
			
			VAR _Hoje = TODAY()
			RETURN
			    IF(
			        'planos_acao_ted'[dt_inicio_vigencia] <= _Hoje && 'planos_acao_ted'[dt_fim_vigencia] >= _Hoje,
			        "Vigente",
			        "Não Vigente"
			    )
		lineageTag: 9f86827d-83d3-4f3a-a805-a9161309baaa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

