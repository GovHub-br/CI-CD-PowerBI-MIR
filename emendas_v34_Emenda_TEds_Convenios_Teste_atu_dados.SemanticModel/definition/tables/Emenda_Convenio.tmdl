	column 'Status Vigencia' =
			
			VAR _Hoje = TODAY()
			RETURN
			    IF(
			        'SuaTabela'[dt_inicio_vigencia] <= _Hoje && 'SuaTabela'[dt_fim_vigencia] >= _Hoje,
			        "Vigente",
			        "Não Vigente"
			    )
		lineageTag: 9b95732f-7cd7-4656-85bb-56699ff0496c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

