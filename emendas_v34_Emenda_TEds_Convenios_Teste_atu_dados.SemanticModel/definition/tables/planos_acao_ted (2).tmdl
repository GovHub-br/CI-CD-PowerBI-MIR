			relationship: a8ce6004-708a-443b-9bc7-1a198b8c2c97
			defaultHierarchy: LocalDateTable_657a375c-0ce9-4707-9d5d-c94c1159c93a.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column 'Status Vigencia Plano de Acao' =
			
			VAR _Hoje = TODAY()
			VAR _Inicio = 'planos_acao_ted (2)'[dt_inicio_vigencia]
			VAR _Fim = 'planos_acao_ted (2)'[dt_fim_vigencia]
			
			RETURN
			    IF(
			        NOT(ISBLANK(_Inicio)) && NOT(ISBLANK(_Fim)) &&
			        _Inicio <= _Hoje && _Fim >= _Hoje,
			        "Vigente",
			        "Não Vigente"
			    )
		lineageTag: 7dab4518-37dd-42ca-9e8c-844bb0b145d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

