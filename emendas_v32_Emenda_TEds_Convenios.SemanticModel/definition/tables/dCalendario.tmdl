	partition dCalendario = calculated
		mode: import
		source =
				
				VAR DataMinima = MIN(emenda_convenio[emissao_dia])
				VAR DataMaxima = MAX(emenda_convenio[emissao_dia])
				RETURN
				ADDCOLUMNS (
				    CALENDAR (DataMinima, DataMaxima),
				    "Ano", YEAR([Date]),
				    "MesNum", MONTH([Date]),
				    "NomeMes", FORMAT([Date], "MMMM"),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "AnoMes", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = b98dee6ebcda4e609abaf019207b2721

