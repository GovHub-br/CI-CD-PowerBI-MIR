table _medidas
	lineageTag: 655d390d-d4d5-4079-a2aa-32963eae333e

	measure 'Total Pago Partido' = SUM('emendas_execucao'[despesas_pagas])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 9aaf480d-0d1b-4af1-ba91-f5b0075d7687

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Empenhado Emendas' = SUM(emendas_execucao[despesas_empenhadas])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: fe2b31a4-9493-4fb6-941f-bb71a5e4a08c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Percentual Pago' =
			
			DIVIDE(
			    [Total Pago Partido],
			    [Total Empenhado Emendas],
			    0
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 9afb1a45-6b15-4b29-a039-000bb5f91a6e

