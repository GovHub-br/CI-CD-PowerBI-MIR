		summarizeBy: none
		sourceColumn: dt_ingest

		variation Variation
			isDefault
			relationship: b86c2391-f023-4068-9dd0-438bd4be453d
			defaultHierarchy: LocalDateTable_17f2f81d-adec-4c34-b130-4bbae1600dcb.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column 'Status Vigencia Plano de Acao' =
			
			VAR _Hoje = TODAY()
			VAR _Inicio = 'planos_acao_ted_atualizada'[dt_inicio_vigencia]
			VAR _Fim = 'planos_acao_ted_atualizada'[dt_fim_vigencia]
			
			RETURN
			    IF(
			        NOT(ISBLANK(_Inicio)) && NOT(ISBLANK(_Fim)) &&
			        _Inicio <= _Hoje && _Fim >= _Hoje,
			        "Vigente",
			        "Não Vigente"
			    )
		lineageTag: f92e7228-bb77-48b4-ac03-944d08facbc4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

